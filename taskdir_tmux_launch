#!/bin/bash
# taskdir_tmux_launch — Launch a Claude Code session for a taskdir inside a
# managed tmux pane in the claude-dash dashboard.
#
# Usage: taskdir_tmux_launch <taskdir_path> <claude_args...>
set -e

taskdir="${1:?Usage: taskdir_tmux_launch <taskdir_path> <claude_args...>}"
taskdir=$(cd "$taskdir" && pwd)
shift

# Resolve $CLAUDE_BIN (plain `claude` vs the genie wrapper) via the shared
# resolver. Panes run in a NON-interactive shell where the `claude` alias
# (claude='genie ...') is NOT expanded, so bash_utils reads .infra/machine.local.
INFRA="$(cd "$(dirname "$0")" && pwd)"
source "$INFRA/bash_utils"

# If already inside a managed tmux pane, run claude directly
if [ -n "$CLAUDE_TMUX_MANAGED" ]; then
    cd "$taskdir"
    exec $CLAUDE_BIN "$@"
fi

# --- Derive pane name from ::*.hmm (or an explicit override) ---
if [ -n "$PANE_NAME_OVERRIDE" ]; then
    pane_name=$(echo "$PANE_NAME_OVERRIDE" | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
else
    goal_file=$(ls "$taskdir"/::*.hmm 2>/dev/null | head -1)
    if [ -n "$goal_file" ]; then
        pane_name=$(basename "$goal_file" .hmm | sed 's/^:://' | tr '_' ' ' | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
    else
        pane_name=$(basename "$taskdir" | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
    fi
fi
[ -z "$pane_name" ] && pane_name="claude-task"

# --- Derive a short session display-name via a quick haiku call on the
# ::*.hmm file, passed to the launched claude via -n on first launch only.
# On relaunch (.last_session_id present), claude already has the name
# attached to the resumed session, so skip regen and skip -n entirely
# rather than clobbering it with a re-derived/fallback title. ---
name_flag=""
if [ ! -f "$taskdir/.last_session_id" ]; then
    session_title="$pane_name"
    if [ -n "$goal_file" ]; then
        raw_title=$(cat "$goal_file" 2>/dev/null | timeout 15 $CLAUDE_BIN -p --model haiku \
            --tools "" --no-session-persistence \
            --system-prompt "Generate a title of 6 words or fewer naming the task described in the input. No punctuation, no quotes." \
            --json-schema '{"type":"object","properties":{"title":{"type":"string","description":"6 words max, no punctuation, no quotes"}},"required":["title"]}' \
            2>/dev/null | jq -r '.title // empty' 2>/dev/null)
        if [ -n "$raw_title" ]; then
            session_title=$(echo "$raw_title" | tr -s '[:space:]' ' ' | cut -d' ' -f1-6 | sed 's/[[:space:]]*$//')
        fi
    fi
    escaped_title="$(echo "$session_title" | sed "s/'/'\\\\''/g")"
    name_flag="-n '$escaped_title'"
fi

# --- Source dashboard helpers ---
source "$HOME/.claude/hooks/tmux-helpers.sh"
dash_ensure_session

# --- Handle name collisions ---
base_name="$pane_name"
suffix=1
while true; do
    collision=$(tmux list-panes -t "$CLAUDE_DASH_SESSION:$CLAUDE_DASH_WINDOW" \
        -F '#{@task_name}' 2>/dev/null | grep -cxF "$pane_name" || true)
    [ "$collision" = "0" ] && break
    suffix=$((suffix + 1))
    pane_name="${base_name}-${suffix}"
done

# --- Build the command to run inside the tmux pane ---
escaped_args=""
for arg in "$@"; do
    escaped_args="$escaped_args '$(echo "$arg" | sed "s/'/'\\\\''/g")'"
done

cmd="cd '$taskdir' && export CLAUDE_TMUX_MANAGED=1"
if [ -n "$CLAUDE_ADHOC" ]; then
    cmd="$cmd && export CLAUDE_ADHOC=1"
else
    cmd="$cmd && unset CLAUDE_ADHOC"
fi
cmd="$cmd && exec $CLAUDE_BIN $name_flag $escaped_args"

# Create new pane in the running column
dash_add_task running "$pane_name" "$cmd"

# Exit silently — pane runs detached in dashboard
