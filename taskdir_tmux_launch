#!/bin/bash
# taskdir_tmux_launch — Launch a Claude Code session for a taskdir inside a
# managed tmux pane in the claude-dash dashboard.
#
# Usage: taskdir_tmux_launch <taskdir_path> <claude_args...>
set -e

taskdir="${1:?Usage: taskdir_tmux_launch <taskdir_path> <claude_args...>}"
taskdir=$(cd "$taskdir" && pwd)
shift

# Resolve $CLAUDE_BIN (plain `claude` vs the genie wrapper) via the shared
# resolver. Panes run in a NON-interactive shell where the `claude` alias
# (claude='genie ...') is NOT expanded, so bash_utils reads .infra/machine.local.
INFRA="$(cd "$(dirname "$0")" && pwd)"
source "$INFRA/bash_utils"

# If already inside a managed tmux pane, run claude directly
if [ -n "$CLAUDE_TMUX_MANAGED" ]; then
    cd "$taskdir"
    exec $CLAUDE_BIN "$@"
fi

# --- Derive pane name from ::*.hmm (or an explicit override) ---
if [ -n "$PANE_NAME_OVERRIDE" ]; then
    pane_name=$(echo "$PANE_NAME_OVERRIDE" | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
else
    goal_file=$(ls "$taskdir"/::*.hmm 2>/dev/null | head -1)
    if [ -n "$goal_file" ]; then
        pane_name=$(basename "$goal_file" .hmm | sed 's/^:://' | tr '_' ' ' | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
    else
        pane_name=$(basename "$taskdir" | cut -c1-30 | sed 's/ /-/g; s/[^a-zA-Z0-9_-]//g')
    fi
fi
[ -z "$pane_name" ] && pane_name="claude-task"

# --- Session display-name: use the fast fallback (pane_name) immediately via
# -n so pane creation never blocks. On relaunch (.last_session_id present),
# claude already has a name attached to the resumed session, so skip -n
# entirely rather than clobbering it. A better haiku-derived title (from the
# ::*.hmm file, or the adhoc init prompt) is filled in asynchronously below,
# after the pane exists — it can only update the dashboard label, since
# claude's own session name can't be changed after launch. ---
name_flag=""
title_input=""
if [ ! -f "$taskdir/.last_session_id" ]; then
    escaped_title="$(echo "$pane_name" | sed "s/'/'\\\\''/g")"
    name_flag="-n '$escaped_title'"
    if [ -n "$goal_file" ]; then
        title_input="$(basename "$goal_file" .hmm | sed 's/^:://')
$(cat "$goal_file" 2>/dev/null)"
    elif [ -n "$CLAUDE_ADHOC" ] && [ -n "$1" ]; then
        title_input="$1"
    fi
fi

# --- Source dashboard helpers ---
source "$HOME/.claude/hooks/tmux-helpers.sh"
dash_ensure_session

# --- Handle name collisions ---
base_name="$pane_name"
suffix=1
while true; do
    collision=$(tmux list-panes -t "$CLAUDE_DASH_SESSION:$CLAUDE_DASH_WINDOW" \
        -F '#{@task_name}' 2>/dev/null | grep -cxF "$pane_name" || true)
    [ "$collision" = "0" ] && break
    suffix=$((suffix + 1))
    pane_name="${base_name}-${suffix}"
done

# --- Build the command to run inside the tmux pane ---
escaped_args=""
for arg in "$@"; do
    escaped_args="$escaped_args '$(echo "$arg" | sed "s/'/'\\\\''/g")'"
done

cmd="cd '$taskdir' && export CLAUDE_TMUX_MANAGED=1"
if [ -n "$CLAUDE_ADHOC" ]; then
    cmd="$cmd && export CLAUDE_ADHOC=1"
else
    cmd="$cmd && unset CLAUDE_ADHOC"
fi
cmd="$cmd && exec $CLAUDE_BIN $name_flag $escaped_args"

# Create new pane in the running column
new_pane=$(dash_add_task running "$pane_name" "$cmd")

# --- Fire off the haiku title upgrade in the background, fully detached, so
# this script (and any popup terminal wrapping it) exits immediately instead
# of waiting ~15s on the haiku call. Once it answers, patch the dashboard
# label AND live-rename the running claude session (via /rename, since
# claude's own -n name can't be changed except through that slash command).
#
# `trap '' HUP` must be the very first statement: claude_adhoc execs us in
# place, so we're the session leader of the popup terminal's tty. When we
# exit right after this, the kernel SIGHUPs our foreground process group —
# including this just-forked child, if it hasn't ignored HUP yet. setsid
# alone isn't enough: there's a race between it detaching into a new session
# and the parent exiting. Ignoring HUP first closes that race outright. ---
if [ -n "$title_input" ] && [ -n "$new_pane" ]; then
    (setsid bash -c '
        trap "" HUP
        echo "[$(date +%s)] START pid=$$ pane=$3" >> /tmp/haiku_bg_real.log
        raw_title=$(echo "$1" | "$2" -p --model haiku --bare \
            --tools "" --no-session-persistence \
            --system-prompt "Generate a title of 6 words or fewer naming the task described in the input. No punctuation, no quotes." \
            --json-schema "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"description\":\"6 words max, no punctuation, no quotes\"}},\"required\":[\"title\"]}" \
            2>&1)
        echo "[$(date +%s)] RAW=[$raw_title]" >> /tmp/haiku_bg_real.log
        title=$(echo "$raw_title" | jq -r ".title // empty" 2>&1 | tr -s "[:space:]" " " | cut -d" " -f1-6 | sed "s/[[:space:]]*\$//")
        echo "[$(date +%s)] title=[$title]" >> /tmp/haiku_bg_real.log
        if [ -n "$title" ]; then
            out1=$(tmux set-option -p -t "$3" @task_name "$title" 2>&1); ec1=$?
            out2=$(tmux send-keys -t "$3" "/rename $title" Enter 2>&1); ec2=$?
            echo "[$(date +%s)] set ec=$ec1 out=[$out1] send ec=$ec2 out=[$out2]" >> /tmp/haiku_bg_real.log
        fi
        echo "[$(date +%s)] END" >> /tmp/haiku_bg_real.log
    ' _ "$title_input" "$CLAUDE_BIN" "$new_pane" </dev/null >/dev/null 2>&1 &)
    echo "[$(date +%s)] SPAWNED pane=$new_pane" >> /tmp/haiku_bg_real.log
fi

# Exit silently — pane runs detached in dashboard
