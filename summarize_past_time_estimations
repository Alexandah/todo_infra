#!/bin/bash
set -e

todo_root=$(dirname $(dirname $(realpath $(which "$0"))))
DONE="$todo_root/done"

if [ -n "$1" ]; then
	days_back="$1"
else
	days_back_options=$(
		echo '7 days'
		echo '14 days'
		echo '30 days'
		echo '90 days'
	)
	days_back=$(echo "$days_back_options" | fzf --prompt 'Days back to summarize >' | awk '{print $1}')
fi


sum_expected_minus_actual=0
sum_ratio_actual_over_estimate=0
len=0
for t in $(find "$DONE" -mindepth 1 -type d -mtime -$days_back); do
	# Prefer .time_orig (set by log_time.do) as the original estimate; fall back to :time=*
	orig_file="$t/.time_orig"
	if [ -f "$orig_file" ]; then
		time=$(cat "$orig_file")
	else
		tf=("$t"/:time=*)
		[ -f "${tf[0]}" ] || continue
		time="${tf[0]##*=}"; time="${time%h}"
	fi
	twf=("$t"/:time_worked=*)
	[ -f "${twf[0]}" ] || continue
	time_worked="${twf[0]##*=}"; time_worked="${time_worked%h}"
	error=$(echo "scale=2; $time - $time_worked" | bc)
	ratio_actual_over_estimate=$(echo "scale=2; $time_worked / $time" | bc)
	echo "$(basename $t)"
	echo "	expected: $time	actual: $time_worked	error: $error	%-more-or-less: $ratio_actual_over_estimate"
	echo
	len=$((len + 1))
	sum_expected_minus_actual=$(echo "scale=2; $time - $time_worked + $sum_expected_minus_actual" | bc)
	sum_ratio_actual_over_estimate=$(echo "scale=2; $ratio_actual_over_estimate + $sum_ratio_actual_over_estimate" | bc)
done

# Incomplete tasks (still in active queues) count as underestimated by their full estimate
for t in $(find "$todo_root"/{0_now,1_today,2_week} -mindepth 1 -type d 2>/dev/null); do
	# Prefer .time_orig as the original estimate; fall back to :time=*
	orig_file="$t/.time_orig"
	if [ -f "$orig_file" ]; then
		time=$(cat "$orig_file")
	else
		tf=("$t"/:time=*)
		[ -f "${tf[0]}" ] || continue
		time="${tf[0]##*=}"; time="${time%h}"
	fi
	error=$(echo "scale=2; 0 - $time" | bc)
	ratio_actual_over_estimate=2  # assume overrun at 2x; actual time unknown
	echo "$(basename $t) (INCOMPLETE)"
	echo "	expected: $time	actual: ???	error: $error	%-more-or-less: $ratio_actual_over_estimate"
	echo
	len=$((len + 1))
	sum_expected_minus_actual=$(echo "scale=2; 0 - $time + $sum_expected_minus_actual" | bc)
	sum_ratio_actual_over_estimate=$(echo "scale=2; $ratio_actual_over_estimate + $sum_ratio_actual_over_estimate" | bc)
done

if [ "$len" -gt 0 ]; then
	avg_expected_minus_actual=$(echo "scale=2; $sum_expected_minus_actual / $len" | bc)
	avg_ratio_actual_over_estimate=$(echo "scale=2; $sum_ratio_actual_over_estimate / $len" | bc)
	echo 'Average hours over(+)/under(-)estimated:	'$avg_expected_minus_actual
	echo 'Average hours worked as % of estimate:	'$avg_ratio_actual_over_estimate
else
	echo 'No tasks with time estimates found.'
fi
