#!/bin/bash
set -e

todo_root=$(dirname $(dirname $(realpath $(which "$0"))))
DONE="$todo_root/done"

days_back_options=$(
	echo '7 days'
	echo '14 days'
	echo '30 days'
	echo '90 days'
)
days_back=$(echo "$days_back_options" | fzf --prompt 'Days back to summarize >'| awk '{print $1}')


sum_expected_minus_actual=0
len=0
for t in $(find "$DONE" -mindepth 1 -type d -mtime -$days_back); do 
	if [ ! -f $t/:time=* ]; then
		continue
	fi
	time=$(echo $t/:time=* | sed 's/^.\+=//g' | tr -d 'h')
	if [ ! -f $t/:time_worked=* ]; then
		continue
	fi
	time_worked=$(echo $t/:time_worked=* | sed 's/^.\+=//g' | tr -d 'h')
	error=$(dc -e "$time $time_worked - p")
	#ratio_error_over_estimate=$(dc -e "2 k $(echo $error | sed 's/-/_/g') $time / p")
	ratio_actual_over_estimate=$(dc -e "2 k $time_worked $time / p")
	echo "$(basename $t)"
	echo "	expected: $time	actual: $time_worked	error: $error	%-more-or-less: $ratio_actual_over_estimate"
	echo
	len=$((len + 1))
	sum_expected_minus_actual=$(dc -e "$time $time_worked - $sum_expected_minus_actual + p" | sed 's/-/_/g')
done
avg_expected_minus_actual=$(dc -e "2 k $sum_expected_minus_actual $len / p")
echo 'Average hours over(+)/under(-)estimated:	'$avg_expected_minus_actual
