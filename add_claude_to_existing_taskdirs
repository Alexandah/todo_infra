#!/bin/bash
# add_claude_to_existing_taskdirs — Add _claude.do to all non-done taskdirs
set -e
HERE=$(dirname $(realpath "$0"))
TODOROOT=$(dirname "$HERE")

find "$TODOROOT" -name '::*.hmm' -not -path '*/done/*' -exec dirname {} \; |
while read -r taskdir; do
    if [ ! -f "$taskdir/_claude.do" ]; then
        cp "$HERE/_claude.do" "$taskdir/_claude.do"
        chmod +x "$taskdir/_claude.do"
        echo "Added: $taskdir"
    fi
done
