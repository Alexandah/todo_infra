#!/bin/bash
# Shared utilities for OKR scripts
# Source this after bash_utils

OKR_ROOT="$(dirname "$HERE")/#okr"
CURRENT_YEAR=$(date +%Y)
CURRENT_QUARTER=$(( ($(date +%-m) - 1) / 3 + 1 ))

# fzf gap arg compatibility (same pattern as make_taskdir)
if cat /etc/os-release 2> /dev/null | grep -q 'NAME="Red Hat Enterprise Linux"'; then
    fzf_gap_arg=''
else
    fzf_gap_arg='--gap=1'
fi

# Discover quarterly KR dirs for a given year and quarter.
# Outputs one absolute dir path per line, sorted.
discover_quarterly_krs() {
    local year=${1:-$CURRENT_YEAR}
    local quarter=${2:-$CURRENT_QUARTER}
    find "$OKR_ROOT/$year" -path "*/Q${quarter}/*/*/progress" ! -path "*/__TEMPLATE_*" 2>/dev/null | while read -r pf; do
        dirname "$pf"
    done | sort
}

# Get KR type from a KR directory
get_kr_type() {
    if [ -f "$1/:committed" ]; then
        echo "committed"
    elif [ -f "$1/:aspirational" ]; then
        echo "aspirational"
    else
        echo "unknown"
    fi
}

# Derive STATUS from a numeric score (type-independent)
score_to_status() {
    local score="$1"
    if (( $(echo "$score >= 0.7" | bc -l) )); then
        echo "green"
    elif (( $(echo "$score >= 0.4" | bc -l) )); then
        echo "yellow"
    else
        echo "red"
    fi
}

# Derive GRADE from a numeric score and KR type
score_to_grade() {
    local score="$1"
    local type="$2"
    if [ "$type" = "committed" ]; then
        if (( $(echo "$score >= 1.0" | bc -l) )); then
            echo "green"
        else
            echo "red"
        fi
    else
        score_to_status "$score"
    fi
}

# ANSI color code for a status/grade string
color_for() {
    case "$1" in
        green)  printf "\033[32m" ;;
        yellow) printf "\033[33m" ;;
        red)    printf "\033[31m" ;;
        *)      printf "\033[0m" ;;
    esac
}
ANSI_RESET="\033[0m"
ANSI_BOLD="\033[1m"

# Get last non-comment, non-blank line from a progress file
last_progress_entry() {
    grep -v '^#' "$1/progress" 2>/dev/null | grep -v '^\s*$' | tail -1
}

# Parse fields from a progress entry line
parse_progress_date()   { echo "$1" | awk '{print $1}'; }
parse_progress_score()  { echo "$1" | awk '{print $2}'; }
parse_progress_status() { echo "$1" | awk '{print $3}'; }
parse_progress_notes()  { echo "$1" | awk '{$1=$2=$3=""; print}' | xargs; }

# Human-readable KR label.
# Yearly KR:    Objective / KR_Name
# Quarterly KR: Objective / Yearly_KR / KR_Name
kr_label() {
    local kr_dir="$1"
    local kr_name=$(basename "$kr_dir")
    local parent=$(basename "$(dirname "$kr_dir")")
    if [[ "$parent" =~ ^Q[1-4]$ ]]; then
        local yearly_kr=$(basename "$(dirname "$(dirname "$kr_dir")")")
        local obj=$(basename "$(dirname "$(dirname "$(dirname "$kr_dir")")")")
        echo "$obj / $yearly_kr / $kr_name"
    else
        echo "$parent / $kr_name"
    fi
}
