#!/bin/bash
# ${FZF_DEFAULT_OPTS:-} (not $FZF_DEFAULT_OPTS): this file is sourced by
# prompt_gate under `set -u`, and non-interactive contexts that don't source
# shell rc files (e.g. a tmux-dashboard pane executing a script directly via
# its shebang) never get FZF_DEFAULT_OPTS set at all -- an unguarded reference
# there is a fatal "unbound variable" that silently kills the whole script.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --bind 'ctrl-left:backward-word,ctrl-right:forward-word'"

pscriptdir() {
	echo "$(dirname $(realpath $(which "$0")))"
}

pathtothisfile() {
	echo "$(realpath $(which "$0"))"
}

run() {
	local uuid=$(uuidgen)
	local stdout_file=/tmp/stdout_$uuid	
	local stderr_file=/tmp/stderr_$uuid	
	eval "$@" 1> $stdout_file 2> $stderr_file 
	local exit_code=$?
	STDOUT=$(cat $stdout_file)
	STDERR=$(cat $stderr_file)
	rm $stdout_file
	rm $stderr_file
	return $exit_code
}

crash_if_nonzero_exit() {
	run "$@"
	exit_code=$?
	if [ "0" -ne "$exit_code" ] ; then
		echo -e "ERROR: Crashed due to non-zero exit code of command:	$@" >&2
		echo -e "STDOUT:\n$STDOUT" >&2
		echo -e "STDERR:\n$STDERR" >&2
		echo "EXIT_CODE: $exit_code" >&2
		exit $exit_code
	fi
	return 0
}

# Resolve the Claude command for non-interactive use (scripts, tmux panes,
# `bash -c` children) where the `claude` alias (e.g. claude='genie ...') is
# NOT expanded. A gitignored machine.local beside this file sets CLAUDE_BIN
# explicitly (e.g. genie on AMD machines). Exported so children inherit it.
__bu_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "$__bu_dir/machine.local" ] && source "$__bu_dir/machine.local"
export CLAUDE_BIN="${CLAUDE_BIN:-claude}"
unset __bu_dir

exit_if_dir_outside_of_todo_system() {
	local taskdir_path=$(realpath "$1")
	local taskdir_name=$(basename "$taskdir_path")
	local categories_dir=$(dirname $(dirname $(realpath $(which $0))))

	# Check if taskdir is a directory
	if [ ! -d "$taskdir_path" ]; then
		echo "Error: $taskdir_path is not a directory"
		exit 1
	fi
	# Check if taskdir is in the todo area (but not a category directory itself)
	if find $categories_dir/* -name .infra -prune -o -type d | grep -q "$taskdir_path" ; then
		# Additional check: prevent moving category directories themselves or the todo root
		taskdir_basename=$(basename "$taskdir_path")
		category_parent=$(dirname "$taskdir_path")
		
		# Prevent moving the todo root directory itself
		if [ "$taskdir_path" = "$categories_dir" ]; then
			echo "Error: Cannot move the todo root directory"
			exit 1
		fi
		
		# Prevent moving immediate children of todo root (category directories)
		if [ "$category_parent" = "$categories_dir" ] && [ "$taskdir_basename" != ".infra" ]; then
			echo "Error: Cannot move category directory '$taskdir_basename'"
			exit 1
		fi
		: #taskdir is in todo area and not a category dir, it's ok to move it
	else
		echo "Error: taskdir path not under todo root: $categories_dir"
		exit 1
	fi
}
