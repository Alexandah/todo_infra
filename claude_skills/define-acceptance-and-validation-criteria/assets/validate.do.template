#!/usr/bin/env bash
# validate.do — Acceptance test runner. Re-runnable, idempotent.
# Acceptance criteria below as # === Criterion N: ... === section comments.
set -uo pipefail

PASS=0; FAIL=0; results=()

check() {  # deterministic; args: <name> <cmd...>
    local name="$1"; shift
    if "$@" >/dev/null 2>&1; then
        results+=("[PASS] $name"); ((PASS++))
    else
        results+=("[FAIL] $name"); ((FAIL++))
    fi
}

# JSON schema for verifier output. Passed to `claude --json-schema` (CLI
# enforces). Output lands in the `.structured_output` field of the
# `--output-format json` wrapper.
VERIFIER_SCHEMA='{"type":"object","properties":{"verdict":{"type":"string","enum":["PASS","FAIL"]},"reason":{"type":"string"}},"required":["verdict","reason"]}'

claude_verify() {  # judgment; args: <name> <criterion>
    local name="$1" criterion="$2" out verdict reason
    local prompt="You are a strict verifier. Emit a JSON object matching the provided schema. verdict ∈ {PASS,FAIL}. reason: one short sentence.

Criterion: ${criterion}"
    if ! command -v claude >/dev/null; then
        results+=("[FAIL] $name — claude not in PATH"); ((FAIL++)); return
    fi
    out=$(claude -p --bare --no-session-persistence \
        --model claude-haiku-4-5-20251001 \
        --output-format json \
        --json-schema "$VERIFIER_SCHEMA" \
        "$prompt" 2>/dev/null) || {
        results+=("[FAIL] $name — claude invocation failed"); ((FAIL++)); return
    }

    # CLI enforces schema, but defend against missing field anyway.
    if ! jq -e '.structured_output | type=="object"' <<<"$out" >/dev/null 2>&1; then
        results+=("[FAIL] $name — missing structured_output in CLI wrapper"); ((FAIL++)); return
    fi
    verdict=$(jq -r '.structured_output.verdict // empty' <<<"$out")
    reason=$(jq -r '.structured_output.reason // empty' <<<"$out")
    if [[ "$verdict" != "PASS" && "$verdict" != "FAIL" ]]; then
        results+=("[FAIL] $name — verdict not in {PASS,FAIL}: '$verdict'"); ((FAIL++)); return
    fi
    if [[ -z "$reason" ]]; then
        results+=("[FAIL] $name — reason missing or empty"); ((FAIL++)); return
    fi
    case "$verdict" in
        PASS) results+=("[PASS] $name"); ((PASS++));;
        FAIL) results+=("[FAIL] $name — $reason"); ((FAIL++));;
    esac
}

# >>> CRITERIA SECTIONS — replace below with one `# === Criterion N: ... ===`
# >>> header per criterion (1–5 total). Leave checks empty here; the
# >>> `validate-task` skill fills them in during/after implementation.

# === Criterion 1: <plain-English statement> ===

# === Criterion 2: <plain-English statement> ===

# <<< END CRITERIA SECTIONS

printf '%s\n' "${results[@]}"
echo "---"
echo "PASS=$PASS FAIL=$FAIL"
exit $((FAIL > 0 ? 1 : 0))
