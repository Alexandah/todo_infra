#!/bin/bash
# configure_automation — Interactive Claude taskdir configuration wizard
# Chooses model & effort based on user-selected task difficulty, Walks thru task specification,
# produces a configured _claude.do (which tells Claude to run the taskflow skill, which derives
# acceptance criteria on task start), then self-deletes.
set -e

TASKDIR=$(dirname $(realpath "$0"))
INFRA=$(dirname $(realpath $(which make_taskdir)))
source "$INFRA/bash_utils"

# Detect fzf gap arg (AMD vs personal machine)
if cat /etc/os-release 2>/dev/null | grep -q 'NAME="Rocky Linux"'; then
    fzf_gap_arg=''
else
    fzf_gap_arg='--gap=1'
fi

goal_file=$(ls "$TASKDIR"/::*.hmm 2>/dev/null | head -1)
goal=$(basename "$goal_file" .hmm | sed 's/^:://' | tr '_' ' ')
time_est=$(basename "$TASKDIR"/:time=* 2>/dev/null | sed 's/^:time=//')
deadline=$(basename "$TASKDIR"/:by_* 2>/dev/null | sed 's/^:by_//' | tr '_' ' ')


# ── Task Difficulty ────────────────────────────────────────────────────────────────────
crash_if_nonzero_exit \
    'printf "medium\neasy\nhard\nDEATH" | fzf --prompt="TASK DIFFICULTY > " \
        --header="Estimate task difficulty-- picks model + effort" '"$fzf_gap_arg"
task_difficulty="$STDOUT"

if [ "$task_difficulty" = "easy" ]; then
    model_choice="sonnet"
    effort_choice="low"
    not_easy=0
    chose_default_option=false
elif [ "$task_difficulty" = "medium" ]; then
    model_choice="sonnet"
    effort_choice="high"
    not_easy=1
    chose_default_option=true
elif [ "$task_difficulty" = "hard" ]; then
    model_choice="opus"
    effort_choice="medium"
    not_easy=1
    chose_default_option=false
elif [ "$task_difficulty" = "DEATH" ]; then
    model_choice="opus"
    effort_choice="max"
    not_easy=1
    chose_default_option=false
else
    echo "ERROR: Unrecognized task difficulty"
    exit 1
fi


# ── Detailed task specification enforced for non-trivial tasks ──────────────────────────────────────
if [ "$not_easy" -eq 1 ]; then
    # ── Context files (file browser dialog) ──────────────────────────────────────
    echo ""
    echo "Add relevant files/symlinks to the taskdir for reference. Press 'q' when done."
    if cat /etc/os-release 2>/dev/null | grep -q 'NAME="Rocky Linux"'; then
        sleep 2
        ranger "$TASKDIR" || true
    else
        lf \
            -command 'set promptfmt "Add relevant files/symlinks to the taskdir for reference. Press '"'"'q'"'"' when done. \033[34;1m%d\033[0m\033[1m%f\033[0m"' \
            -command 'set ratios 2:3' \
            "$TASKDIR" || true
    fi
    echo ""

    # ── QA-gate the task spec ──────────────────────────────────────
    echo "[Prompt QA]"
    # Force task spec if .hmm is empty
    while [ -n "$goal_file" ] && [ ! -s "$goal_file" ]; do
        echo "Goal file is empty — opening in hmm. Add some details and save to spec the task."
        sleep 2
        hmm "$goal_file"
    done
    # configure_automation self-deletes after one run, so this is the moment to enforce a usable spec.
    # prompt_gate loops the user through hmm until the spec passes
    # prompt_qa_policy.md — it never autocorrects (the human sharpens the goal).
    # Ctrl-C aborts the wizard; prompt_gate's trap leaves the .hmm clean.
    if [ -z "$goal_file" ]; then
        echo "[Prompt QA] ERROR -- No <goal>.hmm file found!"
        sleep 2
        exit 1
    fi

    # ── Async prompt-QA gate ─────────────────────────────────────────────────
    # The gate below can block ~10s+ per LLM eval (and loop on FAIL). Rather
    # than tie up the user's terminal, generate a continuation script carrying
    # all the post-gate work (baked-variable heredoc idiom, same as _claude.do
    # below) and hand it to the tmux dashboard as a RUNNING task. Falls back to
    # running it inline here if the dashboard is unavailable.
    #
    # Values baked into the heredoc below (TASKDIR/INFRA/goal_file/goal/
    # model_choice/effort_choice/chose_default_option) must be shell-escaped
    # with `printf %q` before interpolation: the heredoc word is unquoted, so
    # $var expands to its literal *value* now, and an unescaped value
    # containing quotes/`$(...)`/backticks would corrupt or execute at
    # .qa_gate_continue.sh runtime. printf %q renders each value as a single
    # shell token (e.g. quoted/backslash-escaped) that round-trips byte-
    # identically when the generated assignment is itself evaluated.
    TASKDIR_q=$(printf '%q' "$TASKDIR")
    INFRA_q=$(printf '%q' "$INFRA")
    goal_file_q=$(printf '%q' "$goal_file")
    goal_q=$(printf '%q' "$goal")
    model_choice_q=$(printf '%q' "$model_choice")
    effort_choice_q=$(printf '%q' "$effort_choice")
    chose_default_option_q=$(printf '%q' "$chose_default_option")
    cat > "$TASKDIR/.qa_gate_continue.sh" << QA_CONTINUE_TEMPLATE
#!/bin/bash
# Generated by _configure_automation.do — runs the prompt QA gate, then (on
# PASS) the post-gate remainder of the configure_automation flow.
set -e
TASKDIR=$TASKDIR_q
INFRA=$INFRA_q
goal_file=$goal_file_q
goal=$goal_q
model_choice=$model_choice_q
effort_choice=$effort_choice_q
chose_default_option=$chose_default_option_q

# On any abort (gate FAIL-exit, Ctrl-C, or pane killed by the dashboard),
# restore the original entrypoint so the taskdir stays retryable. On PASS
# (see bottom of this script) the trap is disarmed before cleanup runs.
#
# On an *unexpected* nonzero exit (a real error, not the normal PASS path --
# which disarms this trap first) a dashboard pane would otherwise just vanish:
# tmux closes panes on process exit and dash_add_task doesn't set
# remain-on-exit, so the user never sees the error. So: log it, and if we're
# running inside a dashboard pane (GATE_DASH_PANE set), hold the pane open
# with the error on screen until the user dismisses it.
restore_on_abort() {
    local rc=\$?
    if [ -f "\$TASKDIR/.configure_automation.orig" ]; then
        mv "\$TASKDIR/.configure_automation.orig" "\$TASKDIR/_configure_automation.do"
    fi
    rm -f "\$TASKDIR/_prompt_qa_in_flight.do" "\$TASKDIR/.qa_gate_continue.sh"
    if [ "\$rc" -ne 0 ]; then
        mkdir -p "\$INFRA/log"
        printf '%s\tqa_gate_continue exited %s\ttaskdir=%s\n' "\$(date -Iseconds)" "\$rc" "\$TASKDIR" >> "\$INFRA/log/qa_gate_errors.log"
        if [ -n "\${TMUX_PANE:-}" ]; then
            echo "" >&2
            echo "[QA gate] ERROR: aborted with exit code \$rc (see output above). Taskdir left retryable." >&2
            tmux set-option -p -t "\$TMUX_PANE" remain-on-exit on 2>/dev/null || true
            read -r -p "[QA gate] Press Enter to close this pane... " _ < /dev/tty > /dev/tty 2>/dev/tty || true
        fi
    fi
}
# EXIT covers set -e / normal-exit aborts (e.g. gate FAIL); HUP/TERM need their
# own explicit exit after cleanup, since trapping a signal alone only runs the
# handler and lets the script resume — it does NOT terminate it on its own.
trap restore_on_abort EXIT
trap 'restore_on_abort; exit 143' HUP TERM

export GATE_DASH_PANE="\$TMUX_PANE"
PROMPT_QA_POLICY="\$INFRA/prompt_qa_policy.md" "\$INFRA/prompt_gate" --file "\$goal_file" --editor hmm


# ── Permission mode ────────────────────────────────────────────────────────────
perm_mode="auto"


# ── Log configuration choices for empirical analysis ───────────────────────────────────────────
echo '{"task":"'\$goal'", "model": "'\$model_choice'", "effort": "'\$effort_choice'", "is_default":"'\$chose_default_option'"}' >> "\$INFRA"/log/configure_automation_model_effort.jsonl


# ── Generate configured _claude.do ───────────────────────────────────────────
echo "=== Configuration Summary ==="
echo "  Model:           \$model_choice"
echo "  Effort:          \$effort_choice"
echo "  Permission mode: \$perm_mode"
echo ""

cat > "\$TASKDIR/_claude.do" << TEMPLATE
#!/bin/bash
# Generated by _configure_automation.do
# Model: \$model_choice\${effort_choice:+ | Effort: \$effort_choice} | Permission mode: \$perm_mode
set -e
taskdir="\\\$(cd "\\\$(dirname "\\\$0")" && pwd)"
cd "\\\$taskdir"

CLAUDE_ARGS="--model \$model_choice\${effort_choice:+ --effort \$effort_choice} --permission-mode \$perm_mode"

# Resume by saved session ID if available
if [ -f .last_session_id ]; then
    session_id=\\\$(cat .last_session_id)
    exec \$INFRA/taskdir_tmux_launch "\\\$taskdir" \\\$CLAUDE_ARGS --resume "\\\$session_id"
fi

# Build initial message for new session
goal_file=\\\$(ls ::*.hmm 2>/dev/null | head -1)
goal=\\\$(basename "\\\$goal_file" .hmm | sed 's/^:://' | tr '_' ' ')
time_est=\\\$(basename :time=* 2>/dev/null | sed 's/^:time=//')
deadline=\\\$(basename :by_* 2>/dev/null | sed 's/^:by_//' | tr '_' ' ')

msg="I am working on the following task:
Goal: \\\$goal
Time estimate: \\\$time_est
Deadline: \\\$deadline"

if [ -f "\\\$goal_file" ]; then
    hmm_content=\\\$(cat "\\\$goal_file")
    line_count=\\\$(echo "\\\$hmm_content" | wc -l)
    if [ "\\\$line_count" -gt 1 ]; then
        msg="\\\$msg

Task notes:
\\\$hmm_content"
    fi
fi

msg="\\\$msg

This taskdir runs under the taskflow automation flow. Even in plan mode, your FIRST action MUST be to invoke the taskflow skill (or type /taskflow) — do NOT fall into the generic plan-mode workflow instead. It orchestrates Explore -> Define Criteria -> Plan -> Implement -> Validate -> Finalize with interactive gates, delegating heavy work to subagents.

INVOKE SKILL: /taskflow"

exec \$INFRA/taskdir_tmux_launch "\\\$taskdir" \\\$CLAUDE_ARGS "\\\$msg"
TEMPLATE
chmod +x "\$TASKDIR/_claude.do"
echo "Generated _claude.do  (--model \$model_choice --effort \$effort_choice --permission-mode \$perm_mode)"


# ── Launching Claude ───────────────────────────────────────────────────────────────
echo ""
echo "Configuration complete. Running ./_claude.do to launch Claude for this task.."
pushd "\$TASKDIR"
    timestamp=\$(date '+%D_%T' | tr '/' '-')
    ./_claude.do
    launch_record=";claude_launched_@_\$timestamp"
    ln --symbolic _claude.do "\$launch_record"
popd
echo "Claude launched! Press ';' in lf/ranger to open the claude-taskdir-tmux dashboard & monitor task progress."
echo ""
sleep 2


# ── Cleanup (PASS path): disarm the abort trap and remove in-flight artifacts ──
# Covers both the dashboard path (\$0/_configure_automation.do was renamed to
# .configure_automation.orig before this pane launched) and the no-dashboard
# fallback path (this script ran inline; _configure_automation.do is untouched
# and still needs its self-delete, equivalent of the original "rm \\\$0").
trap - EXIT HUP TERM
rm -f "\$TASKDIR/_prompt_qa_in_flight.do" "\$TASKDIR/.configure_automation.orig" "\$TASKDIR/_configure_automation.do" "\$TASKDIR/.qa_gate_continue.sh"
QA_CONTINUE_TEMPLATE
    chmod +x "$TASKDIR/.qa_gate_continue.sh"

    dash_launched=false
    if command -v tmux >/dev/null 2>&1 && [ -f "$INFRA/claude_hooks/tmux-helpers.sh" ]; then
        if source "$INFRA/claude_hooks/tmux-helpers.sh" 2>/dev/null && dash_ensure_session; then
            qa_pane=$(dash_add_task running "QA gate: $goal" "$TASKDIR/.qa_gate_continue.sh") || qa_pane=""
            if [ -n "$qa_pane" ]; then
                dash_launched=true
                # ── Stash the entrypoint & install an in-flight stub ────────────────
                mv "$0" "$TASKDIR/.configure_automation.orig"
                cat > "$TASKDIR/_prompt_qa_in_flight.do" << STUB
#!/bin/bash
echo "prompt QA gate in flight in dashboard pane $qa_pane — finish or cancel it; taskdir launch pending."
exit 1
STUB
                chmod +x "$TASKDIR/_prompt_qa_in_flight.do"
                echo "[Prompt QA] Running in dashboard pane $qa_pane (column: running). Your terminal is free — Claude will launch there on PASS."
            fi
        fi
    fi

    if [ "$dash_launched" = false ]; then
        # ── Fallback: no dashboard available, run synchronously as before ───────
        "$TASKDIR/.qa_gate_continue.sh"
    fi
    exit 0
fi


# ── Permission mode (easy-task path: no QA gate) ────────────────────────────────
perm_mode="auto"


# ── Log configuration choices for empirical analysis ───────────────────────────────────────────
echo '{"task":"'$goal'", "model": "'$model_choice'", "effort": "'$effort_choice'", "is_default":"'$chose_default_option'"}' >> "$INFRA"/log/configure_automation_model_effort.jsonl


# ── Generate configured _claude.do ───────────────────────────────────────────
echo "=== Configuration Summary ==="
echo "  Model:           $model_choice"
echo "  Effort:          $effort_choice"
echo "  Permission mode: $perm_mode"
echo ""

cat > "$TASKDIR/_claude.do" << TEMPLATE
