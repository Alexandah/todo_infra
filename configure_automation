INVOKE SKILL: /taskflow"

exec $INFRA/taskdir_tmux_launch "\$taskdir" \$CLAUDE_ARGS "\$msg"
TEMPLATE
chmod +x "$TASKDIR/_claude.do"
echo "Generated _claude.do  (--model $model_choice --effort $effort_choice --permission-mode $perm_mode)"


# ── Launching Claude ───────────────────────────────────────────────────────────────
echo ""
echo "Configuration complete. Running ./_claude.do to launch Claude for this task.."
pushd "$TASKDIR"
    timestamp=$(date '+%D_%T' | tr '/' '-')
    ./_claude.do
    launch_record=";claude_launched_@_$timestamp"
    ln --symbolic _claude.do "$launch_record"
popd
echo "Claude launched! Press ';' in lf/ranger to open the claude-taskdir-tmux dashboard & monitor task progress."
echo ""
sleep 2


# ── Self-delete ───────────────────────────────────────────────────────────────
rm "$0"
