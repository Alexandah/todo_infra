#!/bin/bash
# configure_automation — Interactive Claude taskdir configuration wizard
# Walks the user through model/effort/mode choices, always generates acceptance
# criteria, then produces a configured _claude.do and self-deletes.
set -e

TASKDIR=$(dirname $(realpath "$0"))
INFRA=$(dirname $(realpath $(which make_taskdir)))
source "$INFRA/bash_utils"

# Detect fzf gap arg (AMD vs personal machine)
if cat /etc/os-release 2>/dev/null | grep -q 'NAME="Red Hat Enterprise Linux"'; then
    fzf_gap_arg=''
else
    fzf_gap_arg='--gap=1'
fi

goal_file=$(ls "$TASKDIR"/::*.hmm 2>/dev/null | head -1)
goal=$(basename "$goal_file" .hmm | sed 's/^:://' | tr '_' ' ')
time_est=$(basename "$TASKDIR"/:time=* 2>/dev/null | sed 's/^:time=//')
deadline=$(basename "$TASKDIR"/:by_* 2>/dev/null | sed 's/^:by_//' | tr '_' ' ')

echo ""
echo "=== Claude Taskdir Configuration ==="
echo "  Task: $goal"
[ -n "$time_est" ] && echo "  Time: $time_est"
[ -n "$deadline" ] && echo "  Due:  $deadline"
echo ""

# ── Model ────────────────────────────────────────────────────────────────────
crash_if_nonzero_exit \
    'printf "sonnet\nopus\nhaiku" | fzf --prompt="MODEL > " \
        --header="Select Claude model" '"$fzf_gap_arg"
model_choice="$STDOUT"

# ── Effort (not supported by haiku) ──────────────────────────────────────────
effort_choice=""
if [[ "$model_choice" != "haiku" ]]; then
    crash_if_nonzero_exit \
        'printf "medium\nlow\nhigh\nmax" | fzf --prompt="EFFORT > " \
            --header="Effort level (affects depth of reasoning)" '"$fzf_gap_arg"
    effort_choice="$STDOUT"
fi

# ── Planning mode ────────────────────────────────────────────────────────────
crash_if_nonzero_exit \
    'printf "no — act immediately (default)\nyes — plan before acting" | fzf \
        --prompt="PLAN MODE > " \
        --header="Plan mode: Claude proposes a plan and waits for approval" '"$fzf_gap_arg"
planning_raw="$STDOUT"
if [[ "$planning_raw" == yes* ]]; then
    perm_mode="plan"
else
    # ── Permission mode (only asked when not in plan mode) ────────────────────
    crash_if_nonzero_exit \
        'printf "default — prompt for each tool\nauto — auto-accept edits" | fzf \
            --prompt="PERMISSION MODE > " \
            --header="auto: minimal friction; default: confirm every tool use" '"$fzf_gap_arg"
    perm_raw="$STDOUT"
    if [[ "$perm_raw" == auto* ]]; then
        perm_mode="auto"
    else
        perm_mode="default"
    fi
fi

# ── settings.local.json ───────────────────────────────────────────────────────
crash_if_nonzero_exit \
    'printf "no — skip\nyes — configure settings.local.json" | fzf \
        --prompt="SETTINGS.LOCAL.JSON > " \
        --header="Configure per-taskdir Claude Code settings (allowed tools, etc.)" '"$fzf_gap_arg"
settings_choice="$STDOUT"

if [[ "$settings_choice" == yes* ]]; then
    echo ""
    echo "--- Launching Claude to configure settings.local.json ---"
    echo "(Exit the Claude session when done; the wizard will resume.)"
    echo ""
    (
        cd /tmp
        mkdir -p "$TASKDIR/.claude"
        claude --permission-mode auto \
		--add-dir "$TASKDIR" \
		-- \
"You are helping configure .claude/settings.local.json for a Claude Code taskdir session.

Common settings to offer:
- allowedTools: pre-approve specific Bash commands or tool patterns so Claude doesn't prompt for them (e.g., allow 'Bash(git:*)' or 'Bash(npm:*)')
- Allowing writes or reads outside the taskdir

Make suggestions based on the task for what to configure and ask me what I think, then write (or update) the file .claude/settings.local.json accordingly. When done, say 'Done — settings.local.json configured.' and stop."
    )
    echo ""
    echo "--- Returned to configuration wizard ---"
    echo ""
fi

# ── Generate configured _claude.do ───────────────────────────────────────────
echo "=== Configuration Summary ==="
echo "  Model:           $model_choice"
echo "  Effort:          $effort_choice"
echo "  Permission mode: $perm_mode"
echo ""

cat > "$TASKDIR/_claude.do" << TEMPLATE
#!/bin/bash
# Generated by _configure_automation.do
# Model: $model_choice${effort_choice:+ | Effort: $effort_choice} | Permission mode: $perm_mode
set -e
taskdir="\$(cd "\$(dirname "\$0")" && pwd)"
cd "\$taskdir"

CLAUDE_ARGS="--model $model_choice${effort_choice:+ --effort $effort_choice} --permission-mode $perm_mode"

# Attempt to continue most recent session in this directory
if claude \$CLAUDE_ARGS --continue 2>/dev/null; then
    exit 0
fi

# Build initial message for new session
goal_file=\$(ls ::*.hmm 2>/dev/null | head -1)
goal=\$(basename "\$goal_file" .hmm | sed 's/^:://' | tr '_' ' ')
time_est=\$(basename :time=* 2>/dev/null | sed 's/^:time=//')
deadline=\$(basename :by_* 2>/dev/null | sed 's/^:by_//' | tr '_' ' ')

msg="I am working on the following task:
Goal: \$goal
Time estimate: \$time_est
Deadline: \$deadline"

if [ -f "\$goal_file" ]; then
    hmm_content=\$(cat "\$goal_file")
    line_count=\$(echo "\$hmm_content" | wc -l)
    if [ "\$line_count" -gt 1 ]; then
        msg="\$msg

Task notes:
\$hmm_content"
    fi
fi

if [ -f "ACCEPTANCE_CRITERIA" ]; then
    msg="\$msg

ACCEPTANCE CRITERIA:
\$(cat ACCEPTANCE_CRITERIA)"
fi

exec claude \$CLAUDE_ARGS "\$msg"
TEMPLATE
chmod +x "$TASKDIR/_claude.do"
echo "Generated _claude.do  (--model $model_choice --effort $effort_choice --permission-mode $perm_mode)"

# ── Signal file ───────────────────────────────────────────────────────────────
crash_if_nonzero_exit \
    'printf "no\nyes — mark as ready for auto-pickup" | fzf \
        --prompt="SIGNAL FILE > " \
        --header="Creates ;claude_plz_do_this (chmod +x) so automation can detect this task" '"$fzf_gap_arg"
signal_choice="$STDOUT"

if [[ "$signal_choice" == yes* ]]; then
    touch "$TASKDIR/;claude_plz_do_this"
    chmod +x "$TASKDIR/;claude_plz_do_this"
    echo "Created ;claude_plz_do_this"
fi

echo ""
echo "Configuration complete. Run ./_claude.do to launch Claude for this task."
echo ""

# ── Acceptance criteria (fully detached via setsid — no terminal interference) ─
ac_goal_filename=$(basename "$goal_file")
ac_prompt_file=$(mktemp)
cat > "$ac_prompt_file" << ENDPROMPT
You are generating acceptance criteria for a task. The task directory is your working directory.

Read the task file '$ac_goal_filename' to understand the goal and any notes.

Write a list of 1-5 verifiable acceptance criteria. Each must be concrete and testable (objectively verifiable as done or not done).
Err on the side of less rather than more criteria-- drill down to the essential core of the task.

If the task description lacks sufficient detail to produce meaningful criteria, output only this line:
NEEDS_CLARIFICATION: <explanation of what additional details are needed>

Output only the criteria list or the NEEDS_CLARIFICATION line — no headings, no other text.
ENDPROMPT

setsid bash -c \
    'cd "$3" && tmp=$(mktemp) && claude --print --model sonnet --effort low --add-dir "$3" -- "$(cat "$1")" > "$tmp" && mv "$tmp" "$2" || rm -f "$tmp"; rm -f "$1"' \
    _ "$ac_prompt_file" "$TASKDIR/ACCEPTANCE_CRITERIA" "$TASKDIR" \
    < /dev/null > /dev/null 2>&1 &
echo "Acceptance criteria generating in background → ACCEPTANCE_CRITERIA"

# ── Self-delete ───────────────────────────────────────────────────────────────
rm "$0"
