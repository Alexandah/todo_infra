#!/bin/bash
# claude_task — Launch a Claude Code session for a taskdir
# Uses taskdir_tmux_launch for managed tmux window placement.
set -e

taskdir="${1:?Usage: claude_task <taskdir_path>}"
taskdir=$(cd "$taskdir" && pwd)
cd "$taskdir"

# Resume by saved session ID if available
if [ -f .last_session_id ]; then
    session_id=$(cat .last_session_id)
    exec taskdir_tmux_launch "$taskdir" --resume "$session_id"
fi

# No previous session — start new with taskdir context
goal_file=$(ls ::*.hmm 2>/dev/null | head -1)
goal=$(basename "$goal_file" .hmm | sed 's/^:://' | tr '_' ' ')
time_est=$(basename :time=* 2>/dev/null | sed 's/^:time=//')
deadline=$(basename :by_* 2>/dev/null | sed 's/^:by_//' | tr '_' ' ')

msg="I am working on the following task:
Goal: $goal
Time estimate: $time_est
Deadline: $deadline"

# Include .hmm file contents if non-trivial (more than just the title line)
if [ -f "$goal_file" ]; then
    hmm_content=$(cat "$goal_file")
    line_count=$(echo "$hmm_content" | wc -l)
    if [ "$line_count" -gt 1 ]; then
        msg="$msg

Task notes:
$hmm_content"
    fi
fi

# If validate.do is missing or has no criteria, hint Claude to derive them
if [ ! -f "validate.do" ] || ! grep -q "^# === Criterion" validate.do 2>/dev/null; then
    msg="$msg

No validate.do (or no criteria sections) yet. Before starting implementation, invoke the define-acceptance-and-validation-criteria skill to derive 1–5 acceptance criteria for this task and write them into a fresh validate.do scaffold. Then proceed; the validate-task skill takes over at end of work."
fi

msg="$msg

This taskdir runs under the taskflow automation flow. Even in plan mode, your FIRST action MUST be to invoke the taskflow skill (or type /taskflow) — do NOT fall into the generic plan-mode workflow instead. It orchestrates Explore -> Define Criteria -> Plan -> Implement -> Validate -> Finalize with interactive gates, delegating heavy work to subagents. Trivial taskdirs collapse to an inline path."

exec taskdir_tmux_launch "$taskdir" "$msg"
